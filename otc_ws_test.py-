import asyncio
import websockets

WS_URL = "wss://ws2.qxbroker.com/socket.io/?EIO=3&transport=websocket"


async def main():
    print("Connecting to OTC WebSocket...")

    try:
        async with websockets.connect(
            WS_URL,
            ping_interval=20,
            ping_timeout=20
        ) as ws:

            print("WebSocket connected.")
            print("Waiting for server data...")

            for _ in range(20):
                message = await asyncio.wait_for(ws.recv(), timeout=10)
                print("RAW:", message[:500])

    except Exception as e:
        print("WebSocket test failed:", repr(e))


if __name__ == "__main__":
    asyncio.run(main())
