import asyncio
import websockets

WS_URL = "wss://ws2.qxbroker.com/socket.io/?EIO=3&transport=websocket"


async def main():
    print("Connecting to OTC WebSocket...")

    try:
        async with websockets.connect(
            WS_URL,
            ping_interval=20,
            ping_timeout=20,
            close_timeout=10
        ) as ws:

            print("WebSocket connected.")

            # Socket.IO connection
            await ws.send("40")
            print("Sent Socket.IO connect packet.")

            for i in range(30):
                try:
                    message = await asyncio.wait_for(
                        ws.recv(),
                        timeout=10
                    )

                    print(f"DATA {i + 1}: {message[:1000]}")

                except asyncio.TimeoutError:
                    print("No data received in 10 seconds.")

    except Exception as e:
        print("WebSocket test failed:", repr(e))


if __name__ == "__main__":
    asyncio.run(main())
